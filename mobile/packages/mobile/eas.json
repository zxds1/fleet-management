{
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "driver"
      }
    },
    "development-admin": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "admin"
      }
    },
    "driver": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "driver",
        "REQUIRE_PINNING": "1"
      }
    },
    "admin": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "admin",
        "REQUIRE_PINNING": "1"
      }
    },
    "preview-driver": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "driver",
        "REQUIRE_PINNING": "1"
      }
    },
    "preview-admin": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "admin",
        "REQUIRE_PINNING": "1"
      }
    },
    "production-driver": {
      "distribution": "store",
      "android": {
        "buildType": "aab"
      },
      "env": {
        "APP_VARIANT": "driver",
        "REQUIRE_PINNING": "1"
      }
    },
    "production-admin": {
      "distribution": "store",
      "android": {
        "buildType": "aab"
      },
      "env": {
        "APP_VARIANT": "admin",
        "REQUIRE_PINNING": "1"
      }
    }
  },
  "cli": {
    "version": ">= 12.0.0"
  },
  "submit": {
    "production-driver": {
      "android": {
        "serviceAccountKeyPath": "google-play-service-account.json",
        "track": "internal",
        "changesNotSentForReview": true
      }
    },
    "production-admin": {
      "android": {
        "serviceAccountKeyPath": "google-play-service-account.json",
        "track": "internal",
        "changesNotSentForReview": true
      }
    }
  }
}