# Build-time configuration (set in EAS secrets / CI, never commit real values)
API_BASE_URL=https://api.fleet.internal/api/v1
WS_URL=wss://ws.fleet.internal
# Maps SDK for Android only — NOT the Maps URL API. Restrict the key to the Android apps
# (africa.helix.driver / africa.helix.admin) and to every SHA-1 you sign with.
# There is no GOOGLE_SERVICES_JSON: notifications are local, from the realtime gateway (src/push.ts).
GOOGLE_MAPS_API_KEY=
ADMIN_CONTACT=tel:+254700000000
# JSON map of host -> at least TWO base64 SHA-256 SPKI pins (current + backup)
SSL_PINS={"api.fleet.internal":["<pin1>=","<pin2>="]}
# Release profiles set REQUIRE_PINNING=1 (the app refuses to start without valid pins)
