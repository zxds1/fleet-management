{
  "name": "@fleet/worker",
  "version": "1.0.0",
  "description": "Scheduled + queue jobs, outbox relay and the Traccar ingest consumer (05-workers.md, 04-telemetry-ingest.md).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "build": "tsc -b",
    "rebuild": "tsc -b --force",
    "typecheck": "tsc -b --noEmit",
    "lint": "tsc -b --noEmit",
    "test": "jest --passWithNoTests",
    "contract": "tsc -b --noEmit",
    "dev:worker": "npm run build && node dist/index.js --role worker",
    "dev:ingest": "npm run build && node dist/index.js --role ingest",
    "start": "node dist/index.js --role worker",
    "start:ingest": "node dist/index.js --role ingest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@fleet/db": "*",
    "@fleet/shared": "*",
    "ioredis": "^5.4.1",
    "opossum": "^10.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/opossum": "^8.1.9",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "^5.4.0",
    "brace-expansion": "2.1.5",
    "cross-spawn": "7.0.5",
    "glob": "10.5.0",
    "ip-address": "10.3.1",
    "minimatch": "9.0.7",
    "pacote": "21.5.1",
    "sigstore": "4.1.1",
    "tar": "7.5.21"
  }
}
