{
  "expo": {
    "name": "Fleet",
    "slug": "fleet-management",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "fleet",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "platforms": ["android", "ios", "web"],
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#ffffff",
      "resizeMode": "contain"
    },
    "icon": "./assets/icon-1024.png",
    "android": {
      "package": "ke.fleet.management",
      "versionCode": 1,
      "adaptiveIcon": {
        "foreground": "./assets/adaptive-icon-foreground.png",
        "background": {
          "color": "#ffffff"
        }
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "$GOOGLE_MAPS_ANDROID_KEY"
        }
      },
      "googleServicesFile": "./google-services.json",
      "blockedPermissions": ["ACCESS_BACKGROUND_LOCATION"],
      "softwareKeyboardLayoutMode": "pan",
      "minSdkVersion": 24
    },
    "ios": {
      "bundleIdentifier": "ke.fleet.management",
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": "$GOOGLE_MAPS_IOS_KEY"
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Used to capture odometer, fuel gauge, inspection defect and accident scene photos required by fleet policy.",
        "NSLocationWhenInUseUsageDescription": "Used to record your position for shift, refuel and accident records while you are on duty.",
        "NSFaceIDUsageDescription": "Used to unlock the app and your locally stored credentials.",
        "NSPhotoLibraryUsageDescription": "Used to attach existing photos to inspection and accident reports."
      },
      "icon": "./assets/icon-1024.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Fleet needs the camera to capture odometer, gauge, defect and accident photos."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Fleet uses Face ID to unlock your locally stored session."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Fleet records your position for shift, refuel and accident records while you are on duty.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "expo-notifications",
      [
        "@sentry/react-native",
        {
          "organization": "fleet",
          "projectName": "fleet-mobile",
          "platform": "mobile",
          "url": "https://sentry.io"
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "http://localhost:4000/api/v1",
      "wsUrl": "ws://localhost:4001",
      "sentryDsn": "$SENTRY_DSN",
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      },
      "security": {
        "refuseOnRooted": true,
        "certPins": {
          "api.fleet.internal": ["$API_CERT_PIN_SHA256"],
          "ws.fleet.internal": ["$WS_CERT_PIN_SHA256"]
        },
        "deepLinkSchemes": ["fleet", "https"],
        "deepLinkHosts": ["link.fleet.internal", "fleet.internal"]
      },
      "a11y": {
        "maxFontSizeMultiplier": 1.6
      },
      "privacyPolicyUrl": "https://fleet.co.ke/privacy",
      "ios": {
        "appStoreUrl": "https://apps.apple.com/app/id0000000000"
      },
      "android": {
        "playStoreUrl": "https://play.google.com/store/apps/details?id=ke.fleet.management"
      }
    }
  }
}
