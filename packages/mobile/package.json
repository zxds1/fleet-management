  "private": true,
  "description": "Fleet Management driver + admin mobile app (single Expo app, role-based UI) — docs/apps/*.",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
