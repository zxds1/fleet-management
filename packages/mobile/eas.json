{
  "cli": {
    "version": ">= 5.9.0",
    "appVersionSource": "local"
  },
  "build": {
    "base": {
      "node": "20.11.0",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.fleet.internal/api/v1",
        "EXPO_PUBLIC_WS_URL": "https://ws.fleet.internal"
      }
    },
    "driver": {
      "extends": "base",
      "distribution": "internal",
      "channel": "driver",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      },
      "env": {
        "EXPO_PUBLIC_ROLE_TARGET": "driver",
        "EXPO_PUBLIC_FORM_FACTOR": "phone",
        "EXPO_PUBLIC_ENABLE_OBFUSCATION": "1"
      }
    },
    "admin": {
      "extends": "base",
      "distribution": "internal",
      "channel": "admin",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      },
      "env": {
        "EXPO_PUBLIC_ROLE_TARGET": "admin",
        "EXPO_PUBLIC_FORM_FACTOR": "tablet",
        "EXPO_PUBLIC_ENABLE_OBFUSCATION": "1"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal"
    },
    "production": {
      "extends": "base",
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_ROLE_TARGET": "driver",
        "EXPO_PUBLIC_FORM_FACTOR": "phone",
        "EXPO_PUBLIC_ENABLE_OBFUSCATION": "1"
      }
    }
  },
  "submit": {
    "production": {}
  },
  "updates": {
    "codeSigning": {
      "algorithm": "rsa-signature",
      "keyid": "fleet-mobile-expo",
      "certificatePem": "./certs/expo-code-signing.pem"
    }
  }
}
