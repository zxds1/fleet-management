{
  "name": "@fleet/api",
  "version": "1.0.0",
  "description": "Express HTTP service: REST + media presign + telemetry webhook accept (00-overview.md §3).",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "files": ["dist"],
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "build": "tsc -b",
    "rebuild": "tsc -b --force",
    "typecheck": "tsc -b --noEmit",
    "lint": "tsc -b --noEmit",
    "test": "jest --passWithNoTests",
    "contract": "jest --passWithNoTests --testPathPattern contract",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@fleet/db": "*",
    "@fleet/shared": "*",
    "@node-rs/argon2": "^2.0.2",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "otplib": "^12.0.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.2",
    "js-yaml": "^4.1.0",
    "@types/js-yaml": "^4.0.9",
    "jest": "^29.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.4.0"
  }
}
