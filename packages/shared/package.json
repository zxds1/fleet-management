{
  "name": "@fleet/shared",
  "version": "1.0.0",
  "description": "Shared kernel: types, errors, schemas, config keys for the Fleet Management Platform.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mobile": {
      "types": "./dist/mobile.d.ts",
      "default": "./dist/mobile.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "mobile": [
        "dist/mobile.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "build": "tsc -b",
    "rebuild": "tsc -b --force",
    "typecheck": "tsc -b --noEmit",
    "lint": "tsc -b --noEmit",
    "test": "jest --passWithNoTests",
    "contract": "tsc -b --noEmit"
  },
  "dependencies": {
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation-http": "^0.57.1",
    "@opentelemetry/instrumentation-ioredis": "^0.47.0",
    "@opentelemetry/instrumentation-pg": "^0.73.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@sentry/node": "^11.8.0",
    "prom-client": "^15.1.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "^5.4.0",
    "brace-expansion": "2.1.5",
    "cross-spawn": "7.0.5",
    "glob": "10.5.0",
    "ip-address": "10.3.1",
    "minimatch": "9.0.7",
    "pacote": "21.5.1",
    "sigstore": "4.1.1",
    "tar": "7.5.21"
  }
}
