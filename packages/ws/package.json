{
  "name": "@fleet/ws",
  "version": "1.0.0",
  "description": "Socket.IO gateway for admin real-time channels (07-websocket-gateway.md).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "build": "tsc -b",
    "rebuild": "tsc -b --force",
    "typecheck": "tsc -b --noEmit",
    "lint": "tsc -b --noEmit",
    "test": "jest --passWithNoTests",
    "contract": "tsc -b --noEmit",
    "dev:ws": "npm run build && node dist/index.js",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@fleet/db": "*",
    "@fleet/shared": "*",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.7.5",
    "brace-expansion": "2.1.5",
    "cross-spawn": "7.0.5",
    "glob": "10.5.0",
    "ip-address": "10.3.1",
    "minimatch": "9.0.7",
    "pacote": "21.5.1",
    "sigstore": "4.1.1",
    "tar": "7.5.21"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.0.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "^5.4.0"
  }
}
