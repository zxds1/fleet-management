<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31) backup / device-transfer rules.

  Nothing the driver writes may leave the device: the offline outbox database
  (queue.db), the staged photos waiting for upload (helix/outbox) and the
  secure-storage tokens (FlutterSecureStorage). Excluding the app data root
  covers those plus anything the app writes later.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="app_flutter" />
        <exclude domain="file" path="app_flutter/helix/outbox" />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="app_flutter" />
        <exclude domain="file" path="app_flutter/helix/outbox" />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
