<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup rules for API < 31 (android:fullBackupContent).

  Same policy as data_extraction_rules.xml: the outbox database, the staged
  photos and the secure-storage tokens never leave the device.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="app_flutter" />
    <exclude domain="file" path="app_flutter/helix/outbox" />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    <exclude domain="external" path="." />
</full-backup-content>
