{
  "info": {
    "name": "Fleet API Security + Smoke Tests",
    "description": "Deploys-gate Postman collection. Verifies security headers are present on every response, health endpoints are live, and all protected routes fail-secure (401) when Clerk is not configured.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health /healthz",
      "request": {
        "method": "GET",
        "header": [],
        "url": "http://localhost:4000/healthz"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Content-Type is JSON', function () { pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'); });",
              "pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.equal('nosniff');",
              "pm.expect(pm.response.headers.get('X-Frame-Options')).to.equal('DENY');",
              "pm.expect(pm.response.headers.get('Referrer-Policy')).to.equal('no-referrer');",
              "pm.expect(pm.response.headers.get('Strict-Transport-Security')).to.include('max-age=63072000');",
              "pm.expect(pm.response.headers.get('Strict-Transport-Security')).to.include('includeSubDomains');",
              "pm.expect(pm.response.headers.get('Strict-Transport-Security')).to.include('preload');",
              "pm.expect(pm.response.headers.get('Content-Security-Policy')).to.include(\"default-src 'none'\");",
              "pm.expect(pm.response.headers.get('X-Powered-By')).to.be.undefined;",
              "pm.expect(pm.response.headers.get('X-DNS-Prefetch-Control')).to.equal('off');",
              "pm.expect(pm.response.headers.get('X-Download-Options')).to.equal('noopen');",
              "pm.expect(pm.response.headers.get('X-Permitted-Cross-Domain-Policies')).to.equal('none');"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
