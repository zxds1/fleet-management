# =============================================================================
# deploy/.env.example  —  Copy to deploy/.env and fill in real secrets.
# Never commit real secrets. These defaults are intentionally insecure for local
# dev only; SECURITY_ENFORCE=always refuses to boot with insecure JWT/MFA keys.
# =============================================================================

# ── Database / Redis ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=pg_local_dev
POSTGRES_DB=fleet
POSTGRES_PORT=5444
REDIS_PORT=6379

# ── API ──
API_PORT=4000
NODE_ENV=production
LOG_LEVEL=info
SERVICE_NAME=fleet-api
SECURITY_ENFORCE=always
TRUST_PROXY=true

# ── JWT signing (A3.7) — rotate these; never commit real values ──
# Minimum 16 chars; use a high-entropy secret in production.
JWT_SECRET=dev-only-insecure-jwt-secret-change-me
JWT_SECRET_PREVIOUS=
JWT_KID=k1
JWT_KID_PREVIOUS=k0
JWT_ISSUER=fleet-api
ACCESS_TOKEN_TTL_SECONDS=900

# ── MFA encryption (AES-GCM, 32 bytes base64) ──
MFA_ENCRYPTION_KEY=

# ── Clerk (managed auth) — not yet configured; auth fails-secure (401) until set ──
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWKS_URL=
CLERK_JWT_KEY=
CLERK_ISSUER=
CLERK_FRONTEND_URL=
CLERK_AUTHORIZED_PARTIES=
CLERK_JWT_AUDIENCE=
CLERK_CLOCK_SKEW_IN_MS=
CLERK_WEBHOOK_SECRET=

# ── Traccar (third-party GPS) ──
TRACCAR_USERNAME=admin
TRACCAR_PASSWORD=admin

# ── Webhook HMAC (S-1) — set to enable Traccar telemetry verification ──
WEBHOOK_SECRET=

# ── CORS ──
ALLOWED_ORIGINS=

# ── Media / S3 ──
AWS_REGION=af-south-1
S3_MEDIA_BUCKET=fleet-media-local
S3_ACCIDENT_BUCKET=fleet-accident-evidence-local
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Email / SMS (optional; degrade to console/no-op) ──
RESEND_API_KEY=
EMAIL_FROM=fleet@fleet.internal
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=
FRONTEND_URL=http://localhost:3000
CONSENT_REQUIRED_VERSION=2026.1
